[Unit]
Description=Go2 driver stack (ROS 2 domain 0, eth)

[Service]
ExecStart=/home/racecar/dds/go2_run.sh driver
Restart=always
RestartSec=5
StandardOutput=append:/home/racecar/dds/logs/go2-driver.log
StandardError=inherit
KillSignal=SIGINT
# SIGINT only to ros2 launch, which forwards it; the default sends it to every
# node as well, and the second SIGINT interrupts their cleanup.
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=default.target
