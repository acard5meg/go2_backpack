[Unit]
Description=Go2 front camera -> image topics (domain 18 wifi)

[Service]
ExecStart=/home/racecar/dds/go2_run.sh camera
Restart=always
RestartSec=5
StandardOutput=append:/home/racecar/dds/logs/go2-camera.log
StandardError=inherit
KillSignal=SIGINT
# SIGINT only to ros2 launch, which forwards it; the default sends it to every
# node as well, and the second SIGINT interrupts their cleanup.
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=default.target
